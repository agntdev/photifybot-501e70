[
  {
    "name": "Custom prompt sets prompt and asks for selfie",
    "steps": [
      {
        "send": { "callback": "prompt:custom" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "✏️ Custom prompt mode!\n\nType your own style description — for example: \"cyberpunk neon glow\" or \"retro 80s aesthetic\"."
            }
          }
        ]
      },
      {
        "send": { "text": "cyberpunk neon glow" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "✨ Prompt set: \"cyberpunk neon glow\"\n\nSend me your selfie and I'll generate something special!"
            }
          }
        ]
      }
    ]
  },
  {
    "name": "Free text after selfie triggers custom prompt generation",
    "steps": [
      {
        "send": { "callback": "category:love" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "💕 Love style selected!\n\nSend me your selfie and I'll generate a love-themed version."
            }
          }
        ]
      },
      {
        "send": {
          "update": {
            "update_id": 1,
            "message": {
              "message_id": 1,
              "from": { "id": 1, "is_bot": false, "first_name": "Test", "username": "test" },
              "chat": { "id": 1, "type": "private" },
              "date": 0,
              "photo": [
                { "file_id": "test_photo_id", "file_unique_id": "test_photo_unique", "file_size": 1000, "width": 100, "height": 100 }
              ]
            }
          }
        },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "⏳ Generating your image…" }
          }
        ]
      },
      {
        "send": { "text": "cyberpunk neon glow" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "⏳ Generating your image…" }
          }
        ]
      }
    ]
  },
  {
    "name": "Empty whitespace prompt is rejected with helpful message",
    "steps": [
      {
        "send": { "callback": "prompt:custom" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "✏️ Custom prompt mode!\n\nType your own style description — for example: \"cyberpunk neon glow\" or \"retro 80s aesthetic\"."
            }
          }
        ]
      },
      {
        "send": { "text": "   " },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Prompt is too short — try again with more detail." }
          }
        ]
      }
    ]
  },
  {
    "name": "Commands still work after selfie is stored",
    "steps": [
      {
        "send": { "callback": "category:love" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "💕 Love style selected!\n\nSend me your selfie and I'll generate a love-themed version."
            }
          }
        ]
      },
      {
        "send": {
          "update": {
            "update_id": 2,
            "message": {
              "message_id": 2,
              "from": { "id": 1, "is_bot": false, "first_name": "Test", "username": "test" },
              "chat": { "id": 1, "type": "private" },
              "date": 0,
              "photo": [
                { "file_id": "test_photo_id", "file_unique_id": "test_photo_unique", "file_size": 1000, "width": 100, "height": 100 }
              ]
            }
          }
        },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "⏳ Generating your image…" }
          }
        ]
      },
      {
        "send": { "text": "/start" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "👋 Welcome! Tap a button below to get started." }
          }
        ]
      }
    ]
  }
]
